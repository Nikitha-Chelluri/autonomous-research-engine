# LLM (OpenAI, or any OpenAI-compatible server e.g. Ollama on another machine via Tailscale)
OPENAI_API_KEY=
# Ollama: http://<tailscale-ip-or-hostname>:11434/v1 — use the same machine’s Tailscale IP if Ollama runs remotely
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini
# Ollama Qwen example after `ollama pull qwen2.5`:
# OPENAI_API_BASE=http://100.x.x.x:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:latest

# Web search (at least one recommended)
TAVILY_API_KEY=
SERPER_API_KEY=

# Scraping (optional; falls back to httpx + BeautifulSoup)
FIRECRAWL_API_KEY=

# Database
# docker-compose maps host 5433 -> postgres and 6380 -> redis (avoids local port clashes)
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5433/research_engine

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Graph limits
MAX_RESEARCH_ITERATIONS=3

# Streamlit dashboard: avoid http://localhost:8000 on Windows (can hit ::1 where Docker listens)
RESEARCH_API_URL=http://127.0.0.1:8000
